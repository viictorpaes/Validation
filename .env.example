# ==============================================================================
# Sistema de Validação Inteligente de Comprovantes de Residência
# Copie este arquivo para .env e preencha os valores necessários:
#   cp .env.example .env
# ==============================================================================

# Banco de Dados PostgreSQL
POSTGRES_DB=residence_validation
POSTGRES_USER=validator_user
POSTGRES_PASSWORD=validator_secret_pwd
POSTGRES_PORT=5432

# Backend Spring Boot
BACKEND_PORT=8080
SPRING_PROFILES_ACTIVE=prod
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Google Gemini AI (Obrigatório para interpretação via LLM; nunca versionar a chave real)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-hydrogen
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1/interactions
GEMINI_TIMEOUT_SECONDS=45

# Configurações de OCR (Tesseract)
TESSERACT_DATAPATH=/usr/share/tessdata
TESSERACT_LANGUAGE=por+eng

# Regras de Negócio Configuráveis
VALIDATION_MAX_DOCUMENT_AGE_DAYS=90
VALIDATION_MIN_OCR_CHARS=25
VALIDATION_NAME_SIMILARITY_THRESHOLD=0.60
MAX_UPLOAD_SIZE_MB=10

# Frontend React
FRONTEND_PORT=3000
VITE_API_BASE_URL=/api
